# =============================================================================
# HD Manager - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED SECRETS (App will NOT start without these)
# -----------------------------------------------------------------------------

# Flask session secret key - used for session cookies and CSRF protection
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# JWT signing key - used to sign and verify authentication tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL: API Key for External Tools
# -----------------------------------------------------------------------------
# API key for Postman, scripts, external integrations
# When set, you can use this key in the X-API-Key header to authenticate
# Example in Postman: Add header "X-API-Key: your-api-key-here"
# This bypasses JWT authentication and grants admin access
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/hd_manager

# -----------------------------------------------------------------------------
# OPTIONAL CONFIGURATION
# -----------------------------------------------------------------------------

# JWT token expiration in days (default: 24)
JWT_EXPIRATION_DAYS=24

# Server port (default: 5000)
PORT=5000

# Enable debug mode (default: false)
DEBUG=false

# CORS allowed origins (comma-separated, or "*" for all)
CORS_ORIGINS=http://localhost:5173

# Enable request logging (default: false)
LOG_REQUESTS=false

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# SSL (Optional - for HTTPS)
# -----------------------------------------------------------------------------
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
