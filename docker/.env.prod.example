# =============================================================================
# HD Manager - Production Environment Variables
# =============================================================================
# This file should be placed on your production server
# Copy this to: /path/to/hd-manager/docker/.env.prod
# NEVER commit this file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED SECRETS - CHANGE ALL OF THESE IN PRODUCTION!
# -----------------------------------------------------------------------------

# Flask session secret key - used for session cookies and CSRF protection
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_NEW_SECRET_KEY_HERE

# JWT signing key - used to sign and verify authentication tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_NEW_JWT_SECRET_HERE

# Admin API key for runtime log control
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=CHANGE_ME_GENERATE_NEW_ADMIN_KEY_HERE

# API Key for external tools (Postman, scripts, etc.) - OPTIONAL
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable API key authentication
API_KEY=

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------

# Server port (default: 5000)
PORT=5000

# Debug mode - MUST be False in production
DEBUG=False

# CORS allowed origins (comma-separated)
# Replace with your actual server IP/hostname
CORS_ORIGINS=https://192.168.80.5,https://flow-task

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------

# MongoDB connection string
MONGO_URI=mongodb://mongodb-server:27017/hd-manager

# -----------------------------------------------------------------------------
# FILE UPLOADS
# -----------------------------------------------------------------------------

# Maximum file size in MB
MAX_FILE_SIZE_MB=10

# Allowed file extensions (comma-separated)
UPLOAD_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,txt,png,jpg,jpeg,gif

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable request logging (default: false)
LOG_REQUESTS=false

# -----------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# -----------------------------------------------------------------------------

# System name displayed in the UI
SYSTEM_NAME=Flow Task

# API URL (use /api for nginx proxy)
API_URL=/api

# API retry configuration
API_MAX_RETRIES=2
API_RETRY_DELAY=500

# Socket configuration (milliseconds)
SOCKET_TIMEOUT=10000
IDLE_TIMEOUT=300000

# External System URLs - Configure for your environment
SERVICENOW_URL=https://your-servicenow-instance.com
MARS_URL=https://your-mars-instance.com
